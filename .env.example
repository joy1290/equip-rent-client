# Backend that the Next.js server proxies /api/* to (see next.config.ts).
# Local development default: http://localhost:5000
# Production (Vercel):       https://equip-rent-server.vercel.app
BACKEND_URL=http://localhost:5000

# API base path used by client code. Must stay relative ("/api") so every
# browser request is same-origin — Better Auth cookies are blocked across
# sites. Falls back to "/api" when unset (see next.config.ts).
NEXT_PUBLIC_API_URL=/api
